# publish-gate: allowlist. Одна ERE на строку; строка отчёта, совпавшая
# с любой из них, не считается утечкой. Комментарии (#) и пустые игнорируются.
#
# Правило: сюда попадают ТОЛЬКО заведомо обобщённые плейсхолдеры и тест-фикстуры.
# Реальное значение НИКОГДА не добавляется сюда «чтобы прошло» — оно обобщается.

# Плейсхолдеры домашних путей в доках и примерах
/Users/(me|you|user|username|example|operator)/

# IP-адреса внутри tests/ — фикстуры SSRF-гарда и парсеров.
# Боевые адреса в тестах не держим; если появится — обобщить, а не разрешать.
/tests/.*\.(sh|mjs|js|py):.*([0-9]{1,3}\.){3}[0-9]{1,3}

# Диапазоны для документации (RFC 5737) и примеры версий
(192\.0\.2\.|198\.51\.100\.|203\.0\.113\.)
